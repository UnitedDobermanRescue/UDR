const float NOISE_SCALE = 0.6;
const float LARGE_FLOW_WEIGHT = 0.77;
const float MEDIUM_FLOW_WEIGHT = 0.06;
const float SMALL_FLOW_WEIGHT = 0.71;
const float LARGE_FLOW_SCALE = 1.54;
